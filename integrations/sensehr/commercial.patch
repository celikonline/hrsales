+    {
+        var tenant = await db.Tenants.AsNoTracking().FirstOrDefaultAsync(t => t.Id == tenantId, ct).ConfigureAwait(false);
+        return tenant is null ? null : CommercialLicense.Read(tenant.SettingsJson)?.EmployeeLimit;
+    }
+}
