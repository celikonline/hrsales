FROM mcr.microsoft.com/dotnet/sdk:10.0.401 AS build
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props global.json .editorconfig ./
COPY src/ src/
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked dotnet publish src/Sense.Migrator/Sense.Migrator.csproj -c Release -o /publish
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /publish .
USER app
ENTRYPOINT ["dotnet", "Sense.Migrator.dll", "migrate"]
