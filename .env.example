PORT=4173
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4173
NODE_ENV=development
ADMIN_EMAIL=admin@senseik.local
# Run npm run admin:password -- "YOUR_STRONG_PASSWORD"; copy the hash here.
ADMIN_PASSWORD_HASH=
ADMIN_NOTIFICATION_EMAIL=
MAIL_FROM=SenseIK <demo@senseik.local>
# No SMTP: messages remain in a durable local outbox, visible to the administrator.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
TRIAL_DAYS=14
# sandbox = local sales demo. sensehr = actual SenseHR tenant and invitation.
PRODUCT_MODE=sandbox
SENSEHR_API_URL=http://localhost:5000/api
SENSEHR_WEB_URL=http://localhost:3000
SENSEHR_PLATFORM_EMAIL=
SENSEHR_PLATFORM_PASSWORD=
# Optional approved commercial prices (TRY per employee/month, no tax).
PRICE_STARTER=
PRICE_GROWTH=
PRICE_ENTERPRISE=
# Required for production: final approved privacy/notice URL.
PRIVACY_URL=
SUPPORT_EMAIL=
